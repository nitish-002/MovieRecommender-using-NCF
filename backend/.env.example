# ==============================================================================
# CineMatch Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# LOCAL (Docker mapped to port 5433 or local Postgres on 5432):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/movie_recommender

# DEPLOYED / PRODUCTION (Render, Railway, Supabase, Neon, AWS RDS):
# Note: postgres:// and postgresql:// prefixes are automatically converted to asyncpg.
# DATABASE_URL=postgresql://user:password@db-host.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# Secret key for JWT signature (Use a strong random string in production)
SECRET_KEY=dev-secret-key-replace-in-production-with-random-hex
ACCESS_TOKEN_EXPIRE_DAYS=7

# Admin password for benchmark switching & debug role
ADMIN_PASSWORD=12345qwe

# ------------------------------------------------------------------------------
# 3. CORS SETTINGS
# ------------------------------------------------------------------------------
# LOCAL (allows all):
CORS_ORIGINS=*

# PRODUCTION (comma-separated list of your frontend domains):
# CORS_ORIGINS=https://cinematch.vercel.app,https://cinematch.netlify.app

# ------------------------------------------------------------------------------
# 4. MODEL ARTIFACTS
# ------------------------------------------------------------------------------
MODEL_ARTIFACTS_DIR=./model_artifacts
